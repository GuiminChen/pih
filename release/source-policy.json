{
  "schema": "pih.source-release.v1",
  "include": [
    "CMakeLists.txt",
    "CMakePresets.json",
    "pyproject.toml",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "README.zh.md",
    "CONTRIBUTING.md",
    "CONTRIBUTING.zh.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    ".gitignore",
    ".gitattributes",
    ".editorconfig",
    "CHANGELOG.md",
    ".github/workflows/*.yml",
    "cmake/*",
    "deploy/*.py",
    "deploy/*.sh",
    "deploy/Dockerfile.preview",
    "deploy/development/*",
    "docs/*.md",
    "plugins/**/*",
    "python/pih_client/*.py",
    "tests/tools/*.py",
    "tests/native/CMakeLists.txt",
    "tests/cpp/CMakeLists.txt",
    "tests/cpp/**/*.cpp",
    "tests/cpp/**/*.h",
    "tests/fixtures/*.py",
    "tools/*.py",
    "tools/*.json",
    "requirements/*.txt",
    "examples/**/*",
    "release/*.json",
    "include/**/*",
    "src/**/*",
    "kernels/**/*",
    "MANIFEST.in",
    ".dockerignore"
  ],
  "exclude": [
    "plugins/model-deepseek-v41-reference/**",
    "**/__pycache__/**",
    "**/*.pyc",
    "**/out/**",
    "**/build/**",
    "plugins/model-deepseek-v4-flash/link-check/HANDOFF.md",
    "plugins/**/check_objects.py"
  ],
  "forbidden_suffixes": [
    ".so",
    ".dll",
    ".exe",
    ".o",
    ".obj",
    ".a",
    ".lib",
    ".safetensors",
    ".gguf",
    ".pt",
    ".pth",
    ".zip",
    ".tar",
    ".gz",
    ".log"
  ]
}
